{
  "//": "Copy to appsettings.Local.json (gitignored) and adjust. Plays the role of a non-committed .env.",

  "//ReposDirectory": "Absolute path where the Altered repos live / will be cloned. Defaults to the parent folder of this repo (siblings).",
  "ReposDirectory": "C:\\Users\\Reverb\\Documents\\repos",

  "//AlteredDraftUrl": "Where decks-api reaches altered-draft (sealed-deck pool validation). Defaults to http://host.docker.internal:8080, i.e. altered-draft's `make dev` on the host.",
  "AlteredDraftUrl": "http://host.docker.internal:8080",
  "//Uniques": "Optional: dir with manifest.json + format files, mounted over the uniques API's formats/ (keeps confidential format lists out of git).",
  "Uniques": {
    "FormatsDirectory": "C:\\Users\\Reverb\\altered-private\\formats"
  },

  "//Services": "Toggle which services the AppHost mounts. Same shape as appsettings.json.",
  "Services": {
    "auth": { "Enabled": true },
    "decks": { "Enabled": true },
    "collection": { "Enabled": true },
    "ownership": { "Enabled": false },
    "website": { "Enabled": true },
    "uniques": { "Enabled": true },
    "uniques-ui": { "Enabled": true },
    "cards": { "Enabled": false }
  }
}
